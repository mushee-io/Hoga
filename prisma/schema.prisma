generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
enum OrderState {
  DRAFT
  QUOTED
  QUOTE_ACCEPTED
  PAYMENT_PENDING
  PAID
  FULFILLING
  QUALITY_CHECK
  DELIVERED
  FAILED
  CANCELLED
  REFUNDED
}
enum QuoteStatus {
  OPEN
  ACCEPTED
  REJECTED
  SUPERSEDED
}
enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  createdAt DateTime @default(now())
  sessions Session[]
  businesses Business[]
  conversations Conversation[]
  orders Order[]
  reviews Review[]
}
model Session {
  id String @id
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}
model Business {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields:[ownerId], references:[id])
  name String
  slug String @unique
  logo String @default("")
  category String
  shortDescription String
  description String
  agentName String
  personality String
  instructions String
  fulfillmentInstructions String
  currency String @default("USDC")
  published Boolean @default(false)
  sample Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  services Service[]
  conversations Conversation[]
  orders Order[]
  reviews Review[]
  @@index([ownerId])
  @@index([published, category])
}
model Service {
  id String @id @default(cuid())
  businessId String
  business Business @relation(fields:[businessId],references:[id])
  name String
  description String
  price Decimal @db.Decimal(18,6)
  minimum Decimal @db.Decimal(18,6)
  maxDiscount Int @default(0)
  startingPrice Boolean @default(false)
  negotiation Boolean @default(false)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  @@index([businessId])
}
model Conversation {
  id String @id @default(cuid())
  businessId String
  business Business @relation(fields:[businessId], references:[id])
  customerId String
  customer User @relation(fields:[customerId], references:[id])
  createdAt DateTime @default(now())
  messages Message[]
  quotes Quote[]
  @@index([customerId, businessId])
}
model Message {
  id String @id @default(cuid())
  conversationId String
  conversation Conversation @relation(fields:[conversationId], references:[id])
  role String
  content String
  createdAt DateTime @default(now())
  @@index([conversationId, createdAt])
}
model Quote {
  id String @id @default(cuid())
  conversationId String
  conversation Conversation @relation(fields:[conversationId],references:[id])
  version Int
  serviceId String
  serviceName String
  requirements String
  scope String
  amount Decimal @db.Decimal(18,6)
  baseAmount Decimal @db.Decimal(18,6)
  floor Decimal @db.Decimal(18,6)
  maxDiscount Int
  negotiation Boolean
  currency String
  instructions String
  fulfillmentInstructions String
  serviceDescription String
  demo Boolean
  status QuoteStatus @default(OPEN)
  createdAt DateTime @default(now())
  expiresAt DateTime
  order Order?
  @@unique([conversationId, version])
}
model Order {
  id String @id @default(cuid())
  businessId String
  business Business @relation(fields:[businessId], references:[id])
  customerId String
  customer User @relation(fields:[customerId], references:[id])
  quoteId String @unique
  quote Quote @relation(fields:[quoteId], references:[id])
  state OrderState @default(QUOTE_ACCEPTED)
  amount Decimal @db.Decimal(18,6)
  currency String
  businessName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payment Payment?
  fulfillment Fulfillment?
  events OrderEvent[]
  review Review?
  @@index([customerId])
  @@index([businessId, createdAt])
}
model Payment {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields:[orderId], references:[id])
  provider String @default("moove")
  mode String
  reference String @unique
  url String
  amount Decimal @db.Decimal(18,6)
  currency String
  status PaymentStatus @default(PENDING)
  transactionReference String? @unique
  createdAt DateTime @default(now())
  confirmedAt DateTime?
}
model Fulfillment {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields:[orderId], references:[id])
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  startedAt DateTime?
  completedAt DateTime?
  error String?
  qualityResult String?
  deliverable Deliverable?
}
model Deliverable {
  id String @id @default(cuid())
  fulfillmentId String @unique
  fulfillment Fulfillment @relation(fields:[fulfillmentId], references:[id])
  content String
  demo Boolean
  provider String
  model String
  createdAt DateTime @default(now())
}
model OrderEvent {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id])
  state OrderState
  detail String
  createdAt DateTime @default(now())
  @@index([orderId, createdAt])
}
model Review {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields:[orderId],references:[id])
  businessId String
  business Business @relation(fields:[businessId],references:[id])
  customerId String
  customer User @relation(fields:[customerId],references:[id])
  rating Int
  comment String
  createdAt DateTime @default(now())
}
model RateLimit {
  key String @id
  count Int
  resetAt DateTime
}
